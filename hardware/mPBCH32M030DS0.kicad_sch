(title_block (title "mPBCH32M030DS0  CH32M030 Universal Motor Driver") (date "2026-09-24") (rev "0.2") (company "ghostinkoma") (comment 1 "トップシート / 仕様概要") (comment 2 "個人利用可 (クレジット表示必須) / 商用利用は要連絡 / 無保証  -  LICENSE 参照"))
(lib_symbols)
(text "mPBCH32M030DS0 Rev 0.2 — CH32M030C8U7 (QFN48) ユニバーサル・モータードライバ (3相 ・ DC x2 ・ ステッピング)" (at 20 30 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 5d77ad23-9968-5a4f-acf2-526b0e37dc84))
(text "" (at 20 37 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 02d1bf9e-6619-5d42-b44b-db7dbd5adfd5))
(text "・電源: J1 8〜16V と USB-C PD (9/12/15V, ≤5A) を理想ダイオード OR (LM74700 + TPN1R603PL x2)。PD は契約後に MCU が許可" (at 20 44 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 2789c4db-fbfb-5eb0-9fb9-ee24a1617b0a))
(text "・PWM: HB0〜HB2 = TIM1, HB2/HB3 = TIM2 リマップ2 (4 レッグ相補)。ゲート確認 LED x8, 電源 LED x3" (at 20 51 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 31cd3227-e111-5506-b3e4-2acb83394276))
(text "・電流: IA = OPA3 (JP7: HB0/バス), IB = OPA4 (JP5: HB1/HB2), IBUS = PB3 直接。CMP3 or CMP2(+DAC) → TIM1 ブレーキ" (at 20 58 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 91ac603d-a870-5a46-93f2-be1ef32cd925))
(text "・3 相センシング PA5/PA6/PA7: CMP3 + 内部仮想中性点 + TIM2 キャプチャ (センサレス) / TIM2 ホール XOR / ISOURCE 自己診断" (at 20 65 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 1518063b-b02a-59fd-ab08-6e5ffc6e7589))
(text "・QII1 (OPA1+CMP1 → TIM3): タコ・VR センサ入力, ブラシ DC の電流リップル計数 (JP8)" (at 20 72 0) (effects (font (size 2 2)) (justify left bottom)) (uuid f34c4a6b-ace9-5f13-846f-bbcf3cd1fcf4))
(text "・USB-C: USB2.0 FS (ブートローダ書き込み) + PD シンク。RESET, USER/BOOT(+状態 LED), 8MHz 水晶" (at 20 79 0) (effects (font (size 2 2)) (justify left bottom)) (uuid d5494605-c538-5525-86b5-ea863f6b1537))
(text "" (at 20 86 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 751112fe-ff00-51f4-bc28-ad93bb5c73e0))
(text "駆動モード対応表 (J2 の結線)" (at 20 93 0) (effects (font (size 2 2)) (justify left bottom)) (uuid f1a3c177-c4f6-570b-85ed-8b54ddfdd61d))
(text "  3相 FOC       : U=OUT0 V=OUT1 W=OUT2   JP5=1-2 JP7=1-2  保護 CMP3(バス)+CMP2(IA)" (at 20 100 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 98d67fee-7229-5f54-9bcc-5366a37da5be))
(text "  3相 センサレス 6 ステップ : 同上        JP7=2-3 (バス)  CMP3 = BEMF, 保護 CMP2(バス)" (at 20 107 0) (effects (font (size 2 2)) (justify left bottom)) (uuid a4929da5-52c3-560c-8937-4d521650f524))
(text "  DC x2 / ステッピング : A+=OUT0 A-=OUT1 B+=OUT2 B-=OUT3  JP5=2-3 JP7=1-2" (at 20 114 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 53f73994-ed51-569d-ae58-2780d56c6e4f))
