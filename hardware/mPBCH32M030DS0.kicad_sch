(title_block (title "mPBCH32M030DS0  CH32M030 Universal Motor Driver - Main board") (date "2026-09-25") (rev "0.3") (company "ghostinkoma") (comment 1 "トップシート / 仕様概要") (comment 2 "個人利用可 (クレジット表示必須) / 商用利用は要連絡 / 無保証  -  LICENSE 参照"))
(lib_symbols)
(text "mPBCH32M030DS0 Rev 0.3 主基板 — CH32M030C8U7 (QFN48) ユニバーサル・モータードライバ (3相 ・ DC x2 ・ ステッピング)" (at 20 30 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 5ea1547e-2287-51a1-bdb5-31f290489414))
(text "" (at 20 37 0) (effects (font (size 2 2)) (justify left bottom)) (uuid fa5c65be-74bb-5c58-833f-bc48168b6ac0))
(text "・2 層基板 60 x 42mm。部品面 (TOP): 右 = MCU / USB-C / GPIO・I2C・UART・SDI・HALL, 左上 = 電源, 左下 = 基板間コネクタ" (at 20 44 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 32ad8ced-daed-5175-ba36-aa2a072f77a1))
(text "・パワー段 (MOSFET x8, シャント, ゲート確認 LED, 相電圧分圧, NTC, バルク容量) は子基板へ分離し, 裏面同士を" (at 20 51 0) (effects (font (size 2 2)) (justify left bottom)) (uuid e0812cfd-2427-5a3d-a17e-7c7dfad20ab9))
(text "  向かい合わせて J9 (電源 2x5) / J10 (信号 2x11) で接続する (基板間 約5mm, 裏面部品は高さ 2mm 以下)。" (at 20 58 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 75197a66-145b-503d-84d1-00dbee7d8991))
(text "   子基板 A: TPN1R603PL (既存回路, 8〜16V)   B: TKR74F04PB (24V 系)   C: MTN2306AN3 (廉価, ≤3A)   D: MOSFET なし (ピン出し)" (at 20 65 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 46b00ef9-bd84-58d3-a1e0-02cf20d05316))
(text "・コネクタはすべて 2.54mm ピンヘッダ (USB-C を除く)。操作系 (RESET, USER/BOOT, センシング選択 JP2-4/JP8) は TOP 面" (at 20 72 0) (effects (font (size 2 2)) (justify left bottom)) (uuid cc7dcfb9-460d-5b04-9471-09c3cb2ac22b))
(text "・電源: J1 (2x4 ピン, 8〜16V / 24V 系は注記の部品に変更) と USB-C PD (9/12/15V) を理想ダイオード OR" (at 20 79 0) (effects (font (size 2 2)) (justify left bottom)) (uuid cc90adeb-6ab2-5e38-921a-811cd4613593))
(text "・PWM: HB0〜HB2 = TIM1, HB2/HB3 = TIM2 リマップ2。電流: OPA3/OPA4 → ADC, CMP3 or CMP2(+DAC) → TIM1 ブレーキ" (at 20 86 0) (effects (font (size 2 2)) (justify left bottom)) (uuid fd4c1e76-7da3-597b-90dd-2d243b7b4026))
(text "・3 相センシング PA5/PA6/PA7 (CMP3 + 仮想中性点 + TIM2) / ホール XOR, QII1 タコ入力, NTC (子基板の MOSFET 近傍)" (at 20 93 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 01c2c456-c36f-54ab-869b-5d85eb51f950))
(text "" (at 20 100 0) (effects (font (size 2 2)) (justify left bottom)) (uuid c8dd31cc-8045-5bc3-8e42-5be0151632ea))
(text "詳細は README.md, docs/design.md, docs/stacking.md, docs/advanced_features.md を参照。" (at 20 107 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 26a47aa1-6801-5bdb-a5de-a79194ea61cc))
