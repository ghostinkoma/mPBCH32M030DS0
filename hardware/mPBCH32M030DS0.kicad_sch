(title_block (title "mPBCH32M030DS0  CH32M030 Universal Motor Driver") (date "2026-09-24") (rev "0.1") (company "ghostinkoma") (comment 1 "トップシート / 仕様概要") (comment 2 "個人利用可 (クレジット表示必須) / 商用利用は要連絡 / 無保証  -  LICENSE 参照"))
(lib_symbols)
(text "CH32M030C8U7 (QFN48) ユニバーサル・モータードライバ (3相 BLDC/PMSM ・ フルブリッジ DC x2 ・ バイポーラステッピング)" (at 20 30 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 5d77ad23-9968-5a4f-acf2-526b0e37dc84))
(text "" (at 20 37 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 02d1bf9e-6619-5d42-b44b-db7dbd5adfd5))
(text "・入力: J1 端子台 8〜16V DC (公称 12V) / USB-C 5V (MCU・通信のみ)  ・出力: J2 端子台 4 ハーフブリッジ (TPN1R603PL x8)" (at 20 44 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 2789c4db-fbfb-5eb0-9fb9-ee24a1617b0a))
(text "・MCU: CH32M030C8U7 QFN48 5x5mm (RISC-V 72MHz, N+N プリドライバ x4, OPA x4, CMP x3, USBFS, USB PD, 8MHz 水晶)" (at 20 51 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 31cd3227-e111-5506-b3e4-2acb83394276))
(text "・PWM: HB0〜HB2 = TIM1 (相補), HB2/HB3 = TIM2 リマップ2 (相補) → 4 レッグすべてデッドタイム付き相補駆動" (at 20 58 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 91ac603d-a870-5a46-93f2-be1ef32cd925))
(text "・電流 (内蔵 ADC): IA = OPA3 (HB0) / IB = OPA4 (JP5: HB1 or HB2) / IBUS = バスシャント直接。CMP3/CMP2 → TIM1 ブレーキ" (at 20 65 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 1518063b-b02a-59fd-ab08-6e5ffc6e7589))
(text "・表示: 電源 LED x3 (VBUS / 5V / 3V3), ゲート確認 LED x8 (各ハーフブリッジ H/L), 状態 LED x1" (at 20 72 0) (effects (font (size 2 2)) (justify left bottom)) (uuid f34c4a6b-ace9-5f13-846f-bbcf3cd1fcf4))
(text "・操作: RESET (PC0), USER/BOOT (PC4)。通信: USB-C, I2C (J4), UART (J5), SWD (J7), GPIO 引き出し (J6)" (at 20 79 0) (effects (font (size 2 2)) (justify left bottom)) (uuid d5494605-c538-5525-86b5-ea863f6b1537))
(text "" (at 20 86 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 751112fe-ff00-51f4-bc28-ad93bb5c73e0))
(text "駆動モード対応表 (J2 の結線)" (at 20 93 0) (effects (font (size 2 2)) (justify left bottom)) (uuid f1a3c177-c4f6-570b-85ed-8b54ddfdd61d))
(text "  3相モータ     : U=OUT0 V=OUT1 W=OUT2 (OUT3 未使用)     JP5=1-2  TIM1 CH1-3" (at 20 100 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 98d67fee-7229-5f54-9bcc-5366a37da5be))
(text "  DC モータ 1ch : OUT0-OUT1 (TIM1 CH1/CH2)" (at 20 107 0) (effects (font (size 2 2)) (justify left bottom)) (uuid a4929da5-52c3-560c-8937-4d521650f524))
(text "  DC モータ 2ch : 上記 + OUT2-OUT3 (TIM2 CH1/CH2 リマップ2)    JP5=2-3" (at 20 114 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 53f73994-ed51-569d-ae58-2780d56c6e4f))
(text "  ステッピング  : A+=OUT0 A-=OUT1 B+=OUT2 B-=OUT3      JP5=2-3" (at 20 121 0) (effects (font (size 2 2)) (justify left bottom)) (uuid 3a2c60e4-ed88-5654-b2eb-34f2542195d6))
