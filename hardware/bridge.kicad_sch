(text "バスシャント / 電流チャネル選択 / モータ端子" (at 17 155 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 5174804a-5499-55e8-8ad5-634654fcf806))
(rectangle (start 155 150) (end 405 240) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 0d5eeca6-5ab6-5e21-9cff-c2eb1c10f9e5))
(text "相電圧 (BEMF) 検出 / ホール・相電圧 切替" (at 157 155 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid de8aebf3-e3b5-5d6a-9204-29227a686dfd))
(text "ゲート: 47Ω 直列 + 20kΩ G-S プルダウン (WCH 評価ボード準拠)。シャント 10mΩ はケルビン接続。" (at 18 138 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 97b424a7-5890-51fb-94c9-71dcb045d123))
(text "J2: 3相=U/V/W(1-3) | DC=1-2 (+3-4) | ステッピング=A+,A-,B+,B-" (at 20 255 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 6e5a3518-44af-59fc-b0d5-6302b22594fc))
(text "JP5 1-2: ISP2=HB1(V相)  2-3: ISP2=HB2(コイルB / DC-B)" (at 20 262 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 19689221-fd3e-5f0f-8698-efecdf00a64a))
(text "RS_BUS(R70) は全レッグ共通の帰路 → PB3 で ADC 計測 + CMP3 過電流ブレーキ" (at 20 269 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid cc5ec361-166c-521f-bdf5-4beb3e881bb7))
(text "分圧比 3/23: VBUS 16V → 2.09V。センサレスは ADC で相電圧を PWM ON 中に標本化 (VBUS/2 比較)。" (at 160 228 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 2aeeeba8-0349-5dae-9950-28a859246fd4))
(text "ジャンパ未実装時は SENS_x (PA5/PA7/PA12) を汎用 GPIO/ADC として JP 中央ピンから利用可。" (at 160 234 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 03f94691-9164-567e-b7aa-26b79eb6f40c))
