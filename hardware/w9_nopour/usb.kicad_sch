(text "水晶発振子 (HSE 8MHz)" (exclude_from_sim no) (at 262 30 0) (effects (font (size 2 2) (thickness 0.3) (bold yes)) (justify left bottom)) (uuid "e413c788-c4bb-592f-affa-a011e13ac816"))
(rectangle (start 260 110) (end 405 190) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "664738f8-be17-5cfd-958f-d8632604a90c"))
(text "リセット (RST = PC0)  ※ 上面" (exclude_from_sim no) (at 262 115 0) (effects (font (size 2 2) (thickness 0.3) (bold yes)) (justify left bottom)) (uuid "0ef41256-ea26-5a9c-9455-9f12f848ead6"))
(text "CC1/CC2 = PA0/PA1 (Rd 5.1kΩ 内蔵)。D+/D- = PB0/PB1。USB_VBUS はモジュール端子 J1 の 1/2 番 (子基板の PD 給電経路) へ。" (exclude_from_sim no) (at 23 140 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "5c739ad1-9623-5043-b2e6-2c9fc9b2fd10"))
(text "注意: PD 契約後は USB_VBUS が 9〜15V になる。ブレッドボードでは USB_VBUS ピンに 5V 部品を直結しないこと。" (exclude_from_sim no) (at 23 145 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "016e151c-cc17-5d14-a73d-84351a7823b6"))
(text "XI=PB5 / XO=PB6。C = 2 x (CL - 浮遊容量 約5pF) = 30pF。" (exclude_from_sim no) (at 263 92 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "94d230e8-1383-5652-bc88-63ada27081c9"))
(text "RST ピンはユーザオプションバイトで有効化 (RST_PIN_SEL=0 → PC0)。" (exclude_from_sim no) (at 263 180 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "a1e22aba-3de0-5022-9a76-1555f4175d76"))
