(text "電源デカップリング (ピン直近)" (exclude_from_sim no) (at 17 25 0) (effects (font (size 2 2) (thickness 0.3) (bold yes)) (justify left bottom)) (uuid "5fe04e05-6f36-5be6-b8ca-b0c82786d2d1"))
(rectangle (start 15 100) (end 130 205) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "260fafe1-3b4d-5668-81e9-c01ecd94235f"))
(text "バス電流フィルタ / 過電流比較の閾値" (exclude_from_sim no) (at 17 105 0) (effects (font (size 2 2) (thickness 0.3) (bold yes)) (justify left bottom)) (uuid "58847b09-13a6-5456-9d45-392e579707b2"))
(rectangle (start 280 20) (end 405 110) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "b0c190c2-8639-5495-a7ec-bbcc69270f92"))
(text "電流アンプ入力 (OPA3=ISP1 / OPA4=ISP2 → ADC 内部接続)" (exclude_from_sim no) (at 282 25 0) (effects (font (size 2 2) (thickness 0.3) (bold yes)) (justify left bottom)) (uuid "4f09b77e-ec97-5f8d-9a3c-c0d526c75a7d"))
(rectangle (start 280 115) (end 405 205) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid "525c0af1-b78e-5d80-a6de-91329e8c9280"))
(text "ブートストラップ容量 (VBx-VSx, MCU ピン直近)" (exclude_from_sim no) (at 282 120 0) (effects (font (size 2 2) (thickness 0.3) (bold yes)) (justify left bottom)) (uuid "4b6fa713-0276-52c2-8805-d14f980fb33b"))
(text "VHV 5〜28V (≥10uF, 1206/50V)。VDD8 5/8/9/10V (≥10uF, 2012/25V)。VDD33 4.7uF (1608/16V)。" (exclude_from_sim no) (at 18 85 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "565c02f8-ef6f-5658-bc6b-788f7f3e71cb"))
(text "LDO 負荷上限: VDD8 35mA (ゲート駆動+VDD33 含む) / VDD33 20mA。QFN 裏面パッドが唯一の GND。" (exclude_from_sim no) (at 18 90 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "bc3711a0-9b4f-5d9c-a34b-0e515201254f"))
(text "VBUS_SNS (PB4 = ADC17 + OVP リセット) の分圧抵抗は子基板側 (電圧系ごとに定数が違う)。C16 は MCU 直近の平滑。" (exclude_from_sim no) (at 18 182 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid "77975ccc-8194-5fc6-a20e-1a95ab02461b"))
(text "PB3: バス電流 (10mΩ: 1A = 10mV) + CMP3_P3。PB2: 閾値 254mV (25.4A) = CMP3_N3。" (exclude_from_sim no) (at 18 188 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid "e22074f9-07fa-56f1-a667-68d803d2949a"))
(text "OPA3 出力 → ADC_IN9, OPA4 出力 → ADC_IN10 (チップ内部接続)。ゲイン 4/8/16/55。" (exclude_from_sim no) (at 283 95 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid "081f4264-78f9-5138-8fca-5115b45d34c6"))
(text "2.2uF 1608 (DC バイアス後 ≈1.3uF): Qg 41nC で降下 32mV, Qg ≈150nC でも ≈0.12V。" (exclude_from_sim no) (at 283 180 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid "b9dc0450-9e3e-59af-95ca-b34f4450fdae"))
