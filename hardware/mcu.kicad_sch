(rectangle (start 15 20) (end 130 95) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 3f7d0954-b7ba-5e5e-9e88-4a61b2d1fdb4))
(text "電源デカップリング (ピン直近, DS 図3-1-1)" (at 17 25 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 3b60ba84-97a8-5c29-bb40-22ed5cc54c66))
(rectangle (start 15 100) (end 130 205) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 7e0b83bd-f5c2-5c1d-ad86-eeec00a57a6a))
(text "VBUS 監視・過電圧リセット / バス電流 / 過電流比較" (at 17 105 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 7f109d6a-be6c-58c1-8a08-7857e8cf28e3))
(rectangle (start 280 20) (end 405 110) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid c9aa8e92-cb55-55cd-ad9a-5330370559c1))
(text "電流アンプ入力 (OPA3=ISP1: JP7 選択 / OPA4=ISP2: JP5 選択 → ADC 内部接続)" (at 282 25 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 7888a50f-90bb-5862-9dd3-8e7a79942afa))
(rectangle (start 280 115) (end 405 205) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 9eba64e7-9bad-59cc-97f0-07997c8d12d0))
(text "ブートストラップ容量 (VBx-VSx, ピン直近)" (at 282 120 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 0acb7abe-9fd2-5aab-b610-9ef9ab51cb81))
(rectangle (start 20 212) (end 290 285) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 59ea2431-4c9e-58d0-ada4-ed3e68531902))
(text "ピン割当の要点 (QFN48 = CH32M030C8U7)" (at 22 217 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 37163178-0b37-592f-821c-bc219116bb26))
(text "VHV 4.0〜29V (≥10uF)。VDD8 は FW で 5/8/9/10V 選択 (≥10uF)。VDD33 は 1〜10uF (DS 1.4.3)。" (at 18 85 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid f824b2e2-d6cb-53b5-a456-7ef688cbe0ec))
(text "LDO 負荷上限: VDD8 35mA (ゲート駆動+VDD33 含む) / VDD33 20mA。QFN 裏面パッドが唯一の GND。" (at 18 90 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid a1e710d5-04c5-563d-87dd-49a91b17397a))
(text "PB4: VBUS/12 → ADC_IN17 + OVP リセット (1.5V → VBUS 18.0V で MCU リセット = 全ゲート OFF)。" (at 18 182 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid 2b53b192-4d24-5dea-995f-29dfbeb0c194))
(text "PB3: バス電流 ADC_IN1 (10mΩ: 1A = 10mV) + CMP3_P3。PB2: 閾値 254mV (25.4A) = CMP3_N3 / ADC_IN0。" (at 18 188 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid 34b1c120-9c1b-5078-a056-a518a8ba5e23))
(text "CMP3 → TIM1 BKIN。センサレス (CMP3 を BEMF 用に使う) 時は JP7=バスにして CMP2 で遮断。" (at 18 194 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid bd324674-5c03-5366-8b6f-7269ae5da877))
(text "OPA3 出力 → ADC_IN9, OPA4 出力 → ADC_IN10 (チップ内部接続, RM 17.2.2)。" (at 283 90 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid f4a02534-2547-5541-b789-9e25249c48ed))
(text "ゲイン 4/8/16/55, バイアス 1.6V (10mΩ: G55=±2.9A, G16=±10A, G8=±20A)。" (at 283 95 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid ff9a4760-2942-56e2-b12f-998589fab6d7))
(text "CMP2: P=OPA3 出力, N=内蔵 DAC (0.1〜3.1V/0.2V) → TIM1 BKIN (サイクル毎電流制限にも)。" (at 283 100 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid 454eb2f4-32e2-5933-b05b-e216c2703106))
(text "ブートストラップダイオード内蔵 (平均 7mA / ピーク 70mA まで)。DS 推奨 1〜10uF。" (at 283 175 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid c3c5a4f2-1d81-51ef-9cd2-51b8c23b2810))
(text "Qg=41nC に対し 1uF → 1 周期の電圧降下 ≈ 41mV。" (at 283 180 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid 8182951a-6cc9-50a4-8ebe-bd392c4641c7))
(text "PWM: HB0〜HB2 = TIM1 (相補+ブレーキ)。HB2/HB3 を TIM2 リマップ2 (PB12〜PB15) で駆動すれば 4 レッグ全て相補" (at 25 224 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid af34cea9-8e0b-5b1a-b737-93088e085fc5))
(text "電流: IA = OPA3 (JP7: HB0 レッグ / バス) → ADC9, IB = OPA4 (JP5: HB1 / HB2) → ADC10, IBUS = PB3 直接 → ADC1" (at 25 231 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 5aa36cca-d75b-5d68-9ad9-c68db1fe0d4d))
(text "保護: CMP3 (PB3 vs PB2) または CMP2 (OPA3 出力 vs 内蔵 DAC) → TIM1 BKIN。PB4 OVP リセット" (at 25 238 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 71f13fab-15a6-5261-b652-599df8785e08))
(text "3 相センシング PA5/PA6/PA7 = CMP3 N0/N1/N2 (内部仮想中性点 RMID + TIM2 キャプチャ) = TIM2 CH1/2/3 (ホール XOR)" (at 25 245 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid d2a6b915-69f2-5b1e-8c0e-80457df76b7e))
(text "QII1: PA12 → OPA1 (AV20/40) → CMP1 → TIM3 CH1 キャプチャ (JP8: タコ/VR 入力 or バス電流リップル)" (at 25 252 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid abf20e60-e49d-53ff-9cb2-806036233abf))
(text "USB: CC1/CC2 = PA0/PA1 (PD0 シンク), D+/D- = PB0/PB1, USB VBUS 監視 = PA2, PD 給電許可 = PC3" (at 25 259 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 7d685893-7b3f-5579-8239-67c6177d6d52))
(text "I2C: PA14/PA15 (リマップ2)。UART: PC1/PC2 (リマップ1)。RST: PC0。SDI 1 線: PA3。水晶: PB5/PB6" (at 25 266 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 6e1e40e9-7ae4-55ca-9fd3-812d196bc32b))
(text "J6 引き出し: PC4 (USER/BOOT + 状態 LED), PC5 (HV I/O), TACH_IN, nFAULT (PA13 = TIM1_BKIN_1)" (at 25 273 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 9f6ff30c-87ec-5ea2-896d-be3b1cf3c019))
