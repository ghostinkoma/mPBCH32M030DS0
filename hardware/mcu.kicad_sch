(text "電源デカップリング (ピン直近, DS 図3-1-1)" (at 17 25 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 5fe04e05-6f36-5be6-b8ca-b0c82786d2d1))
(rectangle (start 15 100) (end 130 205) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 260fafe1-3b4d-5668-81e9-c01ecd94235f))
(text "VBUS 監視・過電圧リセット / バス電流 / 過電流比較" (at 17 105 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 58847b09-13a6-5456-9d45-392e579707b2))
(rectangle (start 280 20) (end 405 110) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid b0c190c2-8639-5495-a7ec-bbcc69270f92))
(text "電流アンプ入力 (OPA3=ISP1 / OPA4=ISP2 → ADC 内部接続)" (at 282 25 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 4f09b77e-ec97-5f8d-9a3c-c0d526c75a7d))
(rectangle (start 280 115) (end 405 205) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 525c0af1-b78e-5d80-a6de-91329e8c9280))
(text "ブートストラップ容量 (VBx-VSx, MCU ピン直近 = 主基板)" (at 282 120 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 4b6fa713-0276-52c2-8805-d14f980fb33b))
(rectangle (start 20 212) (end 290 285) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 565c02f8-ef6f-5658-bc6b-788f7f3e71cb))
(text "ピン割当の要点 (QFN48 = CH32M030C8U7)" (at 22 217 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid bc3711a0-9b4f-5d9c-a34b-0e515201254f))
(text "VHV 5〜28V (≥10uF)。VDD8 は FW で 5/8/9/10V 選択 (≥10uF)。VDD33 は 1〜10uF (DS 1.4.3)。" (at 18 85 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 77975ccc-8194-5fc6-a20e-1a95ab02461b))
(text "LDO 負荷上限: VDD8 35mA (ゲート駆動+VDD33 含む) / VDD33 20mA。QFN 裏面パッドが唯一の GND。" (at 18 90 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid e22074f9-07fa-56f1-a667-68d803d2949a))
(text "PB4: VBUS/12 → ADC_IN17 + OVP リセット (1.5V → 18.0V)。24V 系は R11=180k (VBUS/19, 28.5V)。" (at 18 182 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid 081f4264-78f9-5138-8fca-5115b45d34c6))
(text "PB3: バス電流 ADC_IN1 (10mΩ: 1A = 10mV) + CMP3_P3。PB2: 閾値 254mV (25.4A) = CMP3_N3 / ADC_IN0。" (at 18 188 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid b9dc0450-9e3e-59af-95ca-b34f4450fdae))
(text "ISH / ISA_SEL / ISB_SEL は子基板のシャントから J10 経由で来る (ケルビン配線)。" (at 18 194 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid acb11b8e-4f10-5c1a-8d16-2d338c04deaf))
(text "OPA3 出力 → ADC_IN9, OPA4 出力 → ADC_IN10 (チップ内部接続)。電流チャネル選択 JP5/JP7 は子基板。" (at 283 90 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid ced0cc30-a4b2-56c1-aff7-17e658552758))
(text "ゲイン 4/8/16/55, バイアス 1.6V (10mΩ: G55=±2.9A, G16=±10A, G8=±20A)。" (at 283 95 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid e8773874-ed00-52cd-973e-962982d8192b))
(text "CMP2: P=OPA3 出力, N=内蔵 DAC (0.1〜3.1V/0.2V) → TIM1 BKIN。" (at 283 100 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid eee3a08d-97f9-5021-a0c9-67f9bfdbc500))
(text "ブートストラップダイオード内蔵 (平均 7mA / ピーク 70mA まで)。DS 推奨 1〜10uF。" (at 283 175 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid 12454133-550f-5abf-98a1-505aeaa2f463))
(text "2.2uF (1608, DC バイアス後 ≈1.3uF): Qg 41nC (A) で降下 32mV, Qg ≈150nC (B) でも ≈0.12V。" (at 283 180 0) (effects (font (size 1.25 1.25)) (justify left bottom)) (uuid eca1f535-358b-5fad-b073-8f11178c42a6))
(text "PWM: HB0〜HB2 = TIM1 (相補+ブレーキ)。HB2/HB3 を TIM2 リマップ2 (PB12〜PB15) で駆動すれば 4 レッグ全て相補" (at 25 224 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 0c734370-061e-5ff8-892b-56133f0ea841))
(text "電流: IA = OPA3 (子基板 JP7: HB0 / バス) → ADC9, IB = OPA4 (子基板 JP5: HB1 / HB2) → ADC10, IBUS = PB3" (at 25 231 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid dc560fb3-1d10-52af-b941-d2adc93ac3b6))
(text "保護: CMP3 (PB3 vs PB2) または CMP2 (OPA3 出力 vs 内蔵 DAC) → TIM1 BKIN。PB4 OVP リセット" (at 25 238 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 67eaa38a-1f63-5731-9904-693e1d5b4b56))
(text "3 相センシング PA5/PA6/PA7 = CMP3 N0/N1/N2 (仮想中性点 + TIM2 キャプチャ) = TIM2 CH1/2/3 (ホール XOR)" (at 25 245 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid dd342f44-b356-59a1-b3f1-f74460322e57))
(text "QII1: PA12 → OPA1 (AV20/40) → CMP1 → TIM3 CH1 キャプチャ (JP8: タコ/VR 入力 or バス電流リップル)" (at 25 252 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 890fc6ea-69e0-5f9b-9c5f-1e02551eab29))
(text "USB: CC1/CC2 = PA0/PA1 (PD0 シンク), D+/D- = PB0/PB1, USB VBUS 監視 = PA2, PD 給電許可 = PC3" (at 25 259 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid ac128f98-7970-5cb3-9fba-8e4387b00ccd))
(text "I2C: PA14/PA15 (リマップ2)。UART: PC1/PC2 (リマップ1)。RST: PC0。SDI 1 線: PA3。水晶: PB5/PB6" (at 25 266 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid d57a1242-fe7e-5f2e-9232-eb748cd782b0))
(text "J6 引き出し: PC4 (USER/BOOT + 状態 LED), PC5 (HV I/O), TACH_IN, nFAULT (PA13 = TIM1_BKIN_1)" (at 25 273 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 36f1fe65-22d1-5d1e-8639-362fc79ccc96))
