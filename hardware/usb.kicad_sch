(rectangle (start 20 25) (end 250 150) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid e464e03d-c27d-54b5-baa2-d1d87819de30))
(text "USB Type-C (USB2.0 FS デバイス / PD シンク)" (at 22 30 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 442d774b-425d-5552-a077-040ad7a8a752))
(rectangle (start 260 25) (end 405 100) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid ff068a38-fe44-54d0-921e-f743b3d1d1e9))
(text "水晶発振子 (HSE 8MHz)" (at 262 30 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid f04bf6e4-358a-582b-9ffe-fc9b954fd8c4))
(rectangle (start 260 110) (end 405 190) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 33a9e0c2-c86a-56cb-b9e5-ed3cc8d87cca))
(text "リセット (RST = PC0)" (at 262 115 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 38b8249a-501e-52a2-a151-4692a0dbfe8b))
(rectangle (start 20 160) (end 250 280) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid db7833f3-be3d-5e1d-af3d-4df7ad83eb23))
(text "メモ" (at 22 165 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid bb4ea0ae-3128-531a-b27b-a1a041e0fc35))
(text "CC1/CC2 = PA0/PA1 (CC1R/CC2R): C8U7 は Type-C 規定の Rd 5.1kΩ を内蔵 → 外付け Rd 不要 (DS 表1-1 注1)。" (at 23 135 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 18c79af3-ffe7-50d1-a864-86ffd21ad85d))
(text "D+/D- = PB0/PB1 直結 (USBFS の D+ プルアップ内蔵)。VBUS は D6 経由で VHV に OR 接続 (電源シート)。" (at 23 140 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 97d38b49-ad61-5ad8-837c-a7cf5aba2595))
(text "USB PD シンクとして 9V/12V を要求すれば USB-PD 充電器からモータ電源を得る拡張も可能 (FW 次第, 要電流検討)。" (at 23 145 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 5f5c6fd3-ded8-537a-b24a-27203acfad84))
(text "XI=PB5 / XO=PB6。帰還抵抗は内蔵 (DS 表3-9)。C = 2 x (CL - 浮遊容量 約5pF) = 30pF。" (at 263 90 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 072238b5-16fd-5b43-bd55-c060d1edb8bc))
(text "HSE 8MHz x PLL18 = 144MHz → SYSCLK 72MHz / USB 48MHz。水晶の真下は GND ベタ, 配線は最短。" (at 263 95 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 60fee3db-551f-53e3-930a-b6da9dd26f68))
(text "RST ピンはユーザオプションバイトで選択: RST_PIN_SEL=0 → PC0, RST_MODE で有効化" (at 263 175 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid c6410bea-81de-5dfa-8381-f595c655ebdd))
(text "(WCH-LinkUtility で設定, 出荷時は無効の可能性)。無効時は PC0 は通常 GPIO。" (at 263 180 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid f15e8731-7e7f-5440-8d87-47eba4db8508))
(text "・USB は設定変更・ログ・FW 更新 (IAP) 用。IAP 起動判定は PC4 (USER/BOOT ボタン) を使う" (at 23 175 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 2b41f091-1644-59aa-bb61-13d638ce2a2b))
(text "   (WCH の IAP サンプルは PB4 判定なので, 自作ブートローダで PC4 に変更すること)" (at 23 182 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid f7360a52-cd44-5892-af85-d2aaee609353))
(text "・PA2/PA3 (SWCLK/SWDIO) は CC3/CC4 と兼用だが, 本基板では PD1 側は使わずデバッグ専用" (at 23 189 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid f5505dfd-e84e-5573-8beb-aad8277d3900))
(text "・USB-C シールドは 1MΩ || 4.7nF で GND へ (ESD 逃がし)" (at 23 196 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid 9a73c82f-7795-5bd8-88e0-fdcc777fd1c4))
