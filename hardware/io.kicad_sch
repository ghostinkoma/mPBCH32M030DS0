(rectangle (start 15 20) (end 200 120) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 0f4ed19c-6d11-51db-9f05-be990a16e2e1))
(text "ホールセンサ入力 (J3 ピンヘッダ)" (at 17 25 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 6daa4034-7814-566c-9a30-18b8014d63f3))
(rectangle (start 210 20) (end 405 120) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 6c108141-5df8-5bb6-b07a-0d7bc0bea00b))
(text "温度検出 (NTC は子基板) / USER・BOOT ボタン + 状態 LED (PC4 共用)" (at 212 25 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 5397a98d-cf3f-59e0-bffa-fd7d14a67bb6))
(rectangle (start 15 130) (end 200 280) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 86423328-572a-522c-97d1-1df4b8e3a120))
(text "通信 (I2C / UART) / デバッグ (WCH-LinkE 1 線 SDI)" (at 17 135 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 30ef8885-c1ec-51d6-8664-8cbd6b5c5c83))
(rectangle (start 210 130) (end 405 248) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 417dfcab-8942-5e1f-beec-dbc177d11813))
(text "汎用 GPIO 引き出し (J6) / QII1 小信号入力 (タコ・VR センサ・電流リップル)" (at 212 135 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid b2b1bc70-9bf6-5005-a91e-925c53b24a04))
(text "プルアップは 3.3V (MCU 入力保護)。5V プッシュプル出力のホールは 1k 直列で電流制限 (注入 ≤4mA)。" (at 18 112 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 180a3f9c-641e-56c3-9077-9af03b02ae53))
(text "NTC は PA4 (ISOURCE1 内蔵電流源) → ADC_IN5。R110 (DNP) で分圧方式にも変更可。" (at 213 65 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 13fb9030-f941-55f4-9b7c-76d99e9ae672))
(text "状態 LED = PC4 Low で点灯 (USER/BOOT ボタンと共用, ボタン押下中も点灯)。" (at 213 110 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 7c10f5e8-476e-54b0-baab-e3dba51e65da))
(text "I2C プルアップはバスに 1 組。マスタ側に無い場合のみ R114/R115 を実装。" (at 18 268 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 4495fbc1-b6ae-56d7-bccc-1ceb80885847))
(text "J7 の 3V3 は電圧参照用。WCH-Link から 3.3V を供給しないこと (VDD33 ≤ VDD8 ≤ VHV の制約)。" (at 18 274 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 55bba6c5-d4b7-5176-8c26-b29d1310e4b6))
(text "PC4: GPIO / TIM1_CH2_3 / SPI_MISO (USER/BOOT + 状態 LED 兼用, 例: DIR 入力)" (at 213 202 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid e569d81c-1aa2-5c08-9023-62b51b7ea248))
(text "PC5: HV I/O (VHV 系, 入力耐圧 VHV+6V, 出力 ≈1mA) → 12V 系の EN / リミット入力に" (at 213 209 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 8b8407d6-2930-5f61-9918-e19e703fd9db))
(text "TACH_IN → R123 → JP8 1-2 → C105 → PA12: OPA1 (AV 20/40, 自己バイアス 1.23V) → CMP1 → TIM3 CH1" (at 213 216 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid ad61133f-a27d-5997-ab1d-56d7eb058b54))
(text "  ファン FG, VR センサ, 小振幅パルスの周期計測。JP8 2-3 はバス電流の AC 成分 (ブラシ DC リップル計数)" (at 213 223 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 2d4ec2e1-1ae6-5fcc-8a5d-f576cb2695dc))
(text "nFAULT (PA13 = TIM1_BKIN_1): Low で全ゲート OFF。10k プルアップ。3.3V 系 I/O は 5V 非耐性" (at 213 230 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 4339494f-9ef8-5fe6-bdd9-974acd919bd8))
