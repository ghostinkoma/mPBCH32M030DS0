(rectangle (start 15 20) (end 200 120) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 8c2f57f1-c6c6-53b4-a239-a0bb6dcc7776))
(text "ホールセンサ入力 (オープンコレクタ想定)" (at 17 25 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 8687f02a-9c50-5483-b028-8e9c62a370f9))
(rectangle (start 210 20) (end 405 120) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid c9265936-8735-5642-9b78-b33370417804))
(text "温度検出 (NTC ← ISOURCE1) / USER・BOOT ボタン + 状態 LED (PC4 共用)" (at 212 25 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid ae9c5d21-ebc8-5ac0-995d-630a8c9a4bbd))
(rectangle (start 15 130) (end 200 280) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 0ea17f16-6617-5a55-a82e-db078ed2d6ad))
(text "通信 (I2C / UART) / デバッグ (WCH-LinkE 1 線 SDI)" (at 17 135 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid 0b76cc8e-639e-536c-9072-14f94ff83c33))
(rectangle (start 210 130) (end 405 248) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 1adbacfd-59e5-5a30-9927-1d5b74c6f625))
(text "汎用 GPIO 引き出し (J6) / QII1 小信号入力 (タコ・VR センサ・電流リップル)" (at 212 135 0) (effects (font (size 2 2) (thickness 0.3) bold) (justify left bottom)) (uuid fa66077c-12d6-5c2b-85e6-f96258521e31))
(text "プルアップは 3.3V (MCU 入力保護)。5V プッシュプル出力のホールは 1k 直列で電流制限 (注入 ≤4mA)。" (at 18 112 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid e5395df5-9886-5c92-9f8b-187f5b40d428))
(text "NTC は PA4 (ISOURCE1 内蔵電流源) → ADC_IN5。R110 (DNP) で分圧方式にも変更可。" (at 213 65 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 0930fff3-d169-5be4-9e3e-b5f868e469fe))
(text "状態 LED = PC4 Low で点灯 (USER/BOOT ボタンと共用, ボタン押下中も点灯)。PA6 は 3 相センシング (W) へ。" (at 213 110 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 5df6857e-3201-59ab-9da7-7455a6fe8a12))
(text "I2C プルアップはバスに 1 組。マスタ側に無い場合のみ R114/R115 を実装。" (at 18 268 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid f396a9ff-57c4-518f-94ad-832dc7b5f8c8))
(text "J7 の 3V3 は電圧参照用。WCH-Link から 3.3V を供給しないこと (VDD33 ≤ VDD8 ≤ VHV の制約)。" (at 18 274 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 55e919e2-e6f7-5894-82d4-0fe3dd89d939))
(text "PC4: GPIO / TIM1_CH2_3 / SPI_MISO (USER/BOOT + 状態 LED 兼用, 例: DIR 入力)" (at 213 202 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid c32990c7-481e-59c2-9854-a0a7b3848de8))
(text "PC5: HV I/O (VHV 系, 入力耐圧 VHV+6V, 出力 ≈1mA) → 12V 系の EN / リミット入力に" (at 213 209 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 9f5c599d-5316-53fb-a48a-f0013f13f48a))
(text "TACH_IN → R123 → JP8 1-2 → C105 → PA12: OPA1 (AV 20/40, 自己バイアス 1.23V) → CMP1 (ヒス 100/200mV)" (at 213 216 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid ae5bd185-ad43-5ae7-807b-1c2ce56581ac))
(text "  → TIM3 CH1 キャプチャ。ファン FG, VR センサ, 小振幅パルスの周期計測。JP8 2-3 はバス電流の AC 成分" (at 213 223 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 157757d4-4888-5243-802d-5a183b52a256))
(text "  (ブラシ DC の整流子リップル計数 = エンコーダ無し位置推定)。OPA1 出力は ADC IN19 でも読める" (at 213 230 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid cca9c12f-b3b4-5ea1-b9fc-dca032709fc9))
(text "nFAULT (PA13 = TIM1_BKIN_1): Low で全ゲート OFF。10k プルアップ。3.3V 系 I/O は 5V 非耐性" (at 213 237 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid 44c620b9-d2fd-5652-ba4a-ebdef0bc9172))
